[
  {
    "id": "preferences",
    "children": [
      {
        "caption": "Package Settings",
        "id": "package-settings",
        "mnemonic": "P",
        "children": [
          {
            "caption": "Markdown Formatting",
            "children": [
              {
                "caption": "Settings",
                "command": "edit_settings",
                "args": {"base_file": "${packages}/MarkdownFormatting/MarkdownFormatting.sublime-settings", "default": "// Markdown Formatting user settings: copy only the options you want to\n// change from the left pane. Everything else keeps its default.\n{\n\t$0\n}\n"}
              }
            ]
          }
        ]
      }
    ]
  }
]
